rules_version = '2';

// TalentFlow — Firebase Storage Security Rules
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Company Logos: publicly readable, writable only by authenticated company owner (max 5MB, image MIME types)
    match /logos/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId)
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // 2. Candidate CVs: private! Readable only by the candidate owner or authorized authenticated users (companies/admins),
    // writable only by the candidate owner (max 5MB, PDF only)
    match /cvs/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId)
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
    }
  }
}
